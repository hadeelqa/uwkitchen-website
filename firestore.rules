rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // CMS content: anyone can read, only authed admin can write
    match /content/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Tickets: anyone can create (form submissions), only authed admin can read/update/delete
    match /tickets/{ticketId} {
      allow create: if
        request.resource.data.keys().hasAll(['type', 'status', 'createdAt']) &&
        request.resource.data.type in ['maintenance', 'complaint', 'suggestion', 'inquiry'] &&
        request.resource.data.status == 'new' &&
        request.resource.data.size() <= 25;
      allow read, update, delete: if request.auth != null;
    }
  }
}
